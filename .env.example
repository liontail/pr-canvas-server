# Required
MONGODB_URI=mongodb://127.0.0.1:27017,127.0.0.1:27018,127.0.0.1:27019/?retryWrites=true&replicaSet=rs0&readPreference=primary&connectTimeoutMS=10000
PUBLIC_BASE_URL=http://localhost:3000

# Optional
MONGODB_DB=pr_canvas
PORT=3000
MINT_RATE_LIMIT=30
# Hop count (e.g. 1) when behind a reverse proxy, so the mint limiter sees the real client IP
TRUST_PROXY=
