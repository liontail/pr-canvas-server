{
  "name": "pr-canvas-server",
  "version": "1.0.0",
  "description": "Self-hosted PR Lens Canvas API",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test \"test/*.test.js\" \"web/test/*.test.js\"",
    "build:web": "vite build --config web/vite.config.js",
    "dev:web": "vite --config web/vite.config.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@coldtea/pr-lens-renderer": "^0.3.1",
    "@coldtea/pr-lens-schema": "^0.6.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "mongodb": "^7.7.0",
    "openai": "^7.27.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.49.0",
    "preact": "^11.0.0",
    "radix-ui": "^1.6.7",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.1"
  }
}
